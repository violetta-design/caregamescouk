<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>I've Been There</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Josefin+Sans:wght@300;400;600&display=swap');

:root {
  --bg1: #0d3535;
  --bg2: #144444;
  --bg3: #1a5252;
  --horizon: #5bbcb0;
  --sand: #a8e0d8;
  --cream: #e8f7f5;
  --ink: #e0f4f2;
  --ink2: #8eccc6;
  --ink3: #5a9e98;
  --green: #4a9e6e;
  --green-bg: rgba(74,158,110,0.15);
  --card-bg: rgba(255,255,255,0.06);
  --border: rgba(168,224,216,0.2);
  --shadow: 0 8px 32px rgba(0,0,0,0.25);
}

* { margin: 0; padding: 0; box-sizing: border-box; }

body {
  min-height: 100vh;
  background: var(--bg1);
  background-image:
    radial-gradient(ellipse at 50% 0%, rgba(91,188,176,0.2) 0%, transparent 55%),
    radial-gradient(ellipse at 100% 100%, rgba(26,82,82,0.8) 0%, transparent 60%),
    radial-gradient(ellipse at 0% 80%, rgba(13,53,53,0.9) 0%, transparent 50%);
  color: var(--ink);
  font-family: 'Cormorant Garamond', Georgia, serif;
  padding: 2rem 1rem 5rem;
  display: flex;
  flex-direction: column;
  align-items: center;
}

body::before {
  content: '';
  position: fixed;
  inset: 0;
  background-image:
    radial-gradient(1px 1px at 15% 12%, rgba(255,255,255,0.4) 0%, transparent 100%),
    radial-gradient(1px 1px at 72% 8%, rgba(255,255,255,0.3) 0%, transparent 100%),
    radial-gradient(1.5px 1.5px at 40% 5%, rgba(255,255,255,0.5) 0%, transparent 100%),
    radial-gradient(1px 1px at 88% 20%, rgba(255,255,255,0.3) 0%, transparent 100%),
    radial-gradient(1px 1px at 25% 25%, rgba(255,255,255,0.2) 0%, transparent 100%),
    radial-gradient(1px 1px at 60% 15%, rgba(255,255,255,0.3) 0%, transparent 100%);
  pointer-events: none;
  z-index: 0;
}

.wrap {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 640px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.4rem;
}

/* ── Back button ── */
.back-btn {
  position: fixed;
  top: 1rem;
  left: 1rem;
  z-index: 200;
  background: rgba(255,255,255,0.08);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 0.5rem 0.9rem;
  font-family: 'Josefin Sans', sans-serif;
  font-size: 0.8rem;
  letter-spacing: 0.08em;
  color: var(--ink2);
  text-decoration: none;
  cursor: pointer;
  backdrop-filter: blur(8px);
  transition: all 0.2s;
}
.back-btn:hover {
  background: rgba(255,255,255,0.14);
  color: var(--cream);
}

/* ── Header ── */
header {
  text-align: center;
  padding-top: 2.5rem;
}

.title-eyebrow {
  font-family: 'Josefin Sans', sans-serif;
  font-size: 0.68rem;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--horizon);
  margin-bottom: 0.5rem;
}

h1 {
  font-family: 'Cormorant Garamond', serif;
  font-weight: 300;
  font-size: clamp(2.4rem, 7vw, 3.6rem);
  color: var(--cream);
  line-height: 1.05;
  letter-spacing: 0.03em;
}

h1 em { font-style: italic; color: var(--sand); }

.tagline {
  font-family: 'Josefin Sans', sans-serif;
  font-size: 0.72rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--ink3);
  margin-top: 0.5rem;
}

/* ── Stats ── */
.stats {
  display: flex;
  width: 100%;
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 16px;
  overflow: hidden;
  backdrop-filter: blur(8px);
}

.stat {
  flex: 1;
  text-align: center;
  padding: 0.9rem 0.5rem;
  border-right: 1px solid var(--border);
}
.stat:last-child { border-right: none; }

.stat-l {
  font-family: 'Josefin Sans', sans-serif;
  font-size: 0.6rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--ink3);
  margin-bottom: 0.2rem;
}

.stat-v {
  font-family: 'Cormorant Garamond', serif;
  font-size: 1.7rem;
  font-weight: 300;
  color: var(--sand);
  line-height: 1;
}

/* ── Panel ── */
.panel {
  width: 100%;
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 20px;
  padding: 1.5rem 1.6rem;
  backdrop-filter: blur(10px);
  box-shadow: var(--shadow);
}

.panel-label {
  font-family: 'Josefin Sans', sans-serif;
  font-size: 0.62rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--horizon);
  margin-bottom: 0.9rem;
}

/* ── Category buttons ── */
.cat-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 0.6rem;
}

.cat-btn {
  background: rgba(255,255,255,0.04);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 0.7rem 0.6rem;
  font-family: 'Cormorant Garamond', serif;
  font-size: 1rem;
  color: var(--ink2);
  cursor: pointer;
  transition: all 0.2s;
  text-align: center;
  line-height: 1.3;
}

.cat-btn:hover, .cat-btn.active {
  background: rgba(91,188,176,0.15);
  border-color: var(--sand);
  color: var(--sand);
}

/* ── Place card ── */
.place-card { text-align: center; padding: 1rem 0; }

.place-region {
  font-family: 'Josefin Sans', sans-serif;
  font-size: 0.65rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--horizon);
  margin-bottom: 0.6rem;
}

.place-name {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(2rem, 7vw, 2.8rem);
  font-weight: 300;
  color: var(--cream);
  letter-spacing: 0.04em;
  margin-bottom: 0.5rem;
  line-height: 1.1;
}

.place-emoji {
  font-size: 2.2rem;
  margin-bottom: 0.7rem;
  display: block;
}

.place-hint {
  font-style: italic;
  color: var(--ink2);
  font-size: 1.05rem;
  line-height: 1.5;
  padding: 0.8rem 1rem;
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
  margin: 0.5rem 0;
}

/* ── Prompts ── */
.prompts { display: flex; flex-direction: column; gap: 0.55rem; }

.prompt-item {
  display: flex;
  align-items: flex-start;
  gap: 0.7rem;
  padding: 0.7rem 0.9rem;
  background: rgba(255,255,255,0.04);
  border: 1px solid var(--border);
  border-radius: 10px;
  font-size: 1.05rem;
  color: var(--ink);
  line-height: 1.45;
  transition: all 0.2s;
  cursor: pointer;
}

.prompt-item:hover { background: rgba(91,188,176,0.1); border-color: rgba(168,224,216,0.4); }
.prompt-item.used { opacity: 0.35; text-decoration: line-through; }
.prompt-dot { color: var(--horizon); font-size: 1rem; margin-top: 0.15rem; flex-shrink: 0; }

/* ── Score buttons ── */
.score-row {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 0.6rem;
}

.score-btn {
  padding: 0.8rem 0.5rem;
  border-radius: 12px;
  border: 1px solid var(--border);
  background: rgba(255,255,255,0.04);
  font-family: 'Cormorant Garamond', serif;
  font-size: 1rem;
  color: var(--ink2);
  cursor: pointer;
  transition: all 0.2s;
  text-align: center;
  line-height: 1.3;
}

.score-btn:hover { transform: translateY(-1px); }
.score-btn.great { border-color: rgba(74,158,110,0.5); color: #7dd4a4; }
.score-btn.great:hover { background: var(--green-bg); border-color: var(--green); }
.score-btn.ok { border-color: rgba(168,224,216,0.4); color: var(--sand); }
.score-btn.ok:hover { background: rgba(168,224,216,0.1); }
.score-btn.skip { border-color: rgba(192,80,80,0.3); color: #d48888; }
.score-btn.skip:hover { background: rgba(192,80,80,0.1); }

/* ── Buttons ── */
.btn {
  width: 100%;
  padding: 1rem 1.2rem;
  border-radius: 14px;
  border: 1px solid var(--border);
  font-family: 'Cormorant Garamond', serif;
  font-size: 1.2rem;
  cursor: pointer;
  transition: all 0.2s;
  letter-spacing: 0.03em;
}

.btn-primary {
  background: linear-gradient(135deg, var(--horizon), #3da89e);
  color: var(--bg1);
  border-color: transparent;
  font-weight: 600;
  box-shadow: 0 4px 20px rgba(91,188,176,0.3);
}
.btn-primary:hover { transform: translateY(-1px); box-shadow: 0 6px 24px rgba(91,188,176,0.4); }

.btn-ghost { background: rgba(255,255,255,0.04); color: var(--ink2); }
.btn-ghost:hover { background: rgba(255,255,255,0.08); color: var(--ink); }

/* ── Result ── */
.result-banner {
  width: 100%;
  text-align: center;
  padding: 1.5rem;
  border-radius: 18px;
  border: 1px solid var(--border);
  background: rgba(255,255,255,0.04);
}

.result-big { font-size: clamp(1.6rem, 5vw, 2.2rem); color: var(--sand); margin-bottom: 0.4rem; }
.result-sub { font-style: italic; color: var(--ink2); font-size: 1.05rem; }

/* ── Phases ── */
.phase { display: none; flex-direction: column; gap: 1rem; width: 100%; }
.phase.active { display: flex; }

/* ── History ── */
.history-entry {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0.5rem 0;
  border-bottom: 1px solid var(--border);
  font-size: 0.95rem;
}
.history-place { color: var(--ink); font-style: italic; }
.history-score { font-family: 'Josefin Sans', sans-serif; font-size: 0.75rem; letter-spacing: 0.08em; }
.history-score.great { color: #7dd4a4; }
.history-score.ok { color: var(--sand); }
.history-score.skip { color: #d48888; }
</style>
</head>
<body>

<a class="back-btn" href="index.html">← Back</a>

<div class="wrap">

<header>
  <div class="title-eyebrow">A storytelling game</div>
  <h1>I've Been <em>There</em></h1>
  <div class="tagline">Places · Memories · Conversation</div>
</header>

<div class="stats">
  <div class="stat"><div class="stat-l">Places</div><div class="stat-v" id="s-places">0</div></div>
  <div class="stat"><div class="stat-l">Great</div><div class="stat-v" id="s-great">0</div></div>
  <div class="stat"><div class="stat-l">Good</div><div class="stat-v" id="s-ok">0</div></div>
</div>

<!-- PHASE: SETUP -->
<div class="phase active" id="phase-setup">
  <div class="panel">
    <div class="panel-label">Choose a region</div>
    <div class="cat-grid">
      <button class="cat-btn active" onclick="setCat('uk')" id="cat-uk">🇬🇧 British Places</button>
      <button class="cat-btn" onclick="setCat('europe')" id="cat-europe">🌍 European Cities</button>
      <button class="cat-btn" onclick="setCat('nature')" id="cat-nature">🌿 Nature & Coast</button>
      <button class="cat-btn" onclick="setCat('nostalgic')" id="cat-nostalgic">🎠 Nostalgic Britain</button>
    </div>
  </div>

  <div class="panel" style="font-size:1rem; color:var(--ink2); line-height:1.7;">
    <div class="panel-label">How to play</div>
    A place name appears on screen. <em>You</em> read it aloud to her.<br><br>
    Then ask her the conversation prompts — she tells you her memories, feelings or facts about that place.<br><br>
    Tap how well she engaged — <strong style="color:#7dd4a4">Great</strong>, <strong style="color:var(--sand)">Good</strong>, or <strong style="color:#d48888">Skip</strong> — then move to the next place. There are no wrong answers!
  </div>

  <button class="btn btn-primary" onclick="startGame()">✦ Begin the Journey</button>

  <div class="panel" id="history-panel" style="display:none">
    <div class="panel-label">Today's journey</div>
    <div id="history-list"></div>
  </div>
</div>

<!-- PHASE: PLAY -->
<div class="phase" id="phase-play">
  <div class="panel">
    <div class="place-card">
      <div class="place-region" id="place-region">UK</div>
      <span class="place-emoji" id="place-emoji">🏙️</span>
      <div class="place-name" id="place-name">London</div>
      <div class="place-hint" id="place-hint">The capital city of England</div>
    </div>
  </div>

  <div class="panel">
    <div class="panel-label">💬 Ask her any of these — tap to cross off</div>
    <div class="prompts" id="prompts-list"></div>
  </div>

  <div class="panel">
    <div class="panel-label">How did she get on?</div>
    <div class="score-row">
      <button class="score-btn great" onclick="recordScore('great')">🌟 Great<br><small>Lots to say</small></button>
      <button class="score-btn ok" onclick="recordScore('ok')">👍 Good<br><small>Something came</small></button>
      <button class="score-btn skip" onclick="recordScore('skip')">→ Next<br><small>Not this one</small></button>
    </div>
  </div>

  <button class="btn btn-ghost" onclick="backToSetup()">↩ End session</button>
</div>

<!-- PHASE: RESULT -->
<div class="phase" id="phase-result">
  <div class="result-banner">
    <div class="result-big" id="result-title">Wonderful!</div>
    <div class="result-sub" id="result-sub">She had plenty to say about that.</div>
  </div>

  <div class="panel" id="result-memory-box" style="display:none">
    <div class="panel-label">✏️ Jot down what she said (optional)</div>
    <textarea id="memory-note" rows="3"
      style="width:100%;background:rgba(255,255,255,0.04);border:1px solid var(--border);border-radius:10px;color:var(--ink);font-family:'Cormorant Garamond',serif;font-size:1rem;padding:0.8rem;resize:vertical;line-height:1.5;"
      placeholder="Write a memory or story she shared..."></textarea>
  </div>

  <button class="btn btn-primary" onclick="nextPlace()">Next Place ✦</button>
  <button class="btn btn-ghost" onclick="backToSetup()">↩ End session</button>
</div>

</div>

<script>
const PLACES = {
  uk: [
    { name:'London', region:'England', emoji:'🏙️', hint:'The great capital city on the Thames',
      prompts:['Have you ever been to London?','What part of London did you visit?','What do you remember most about it — Buckingham Palace, the shops, the noise?','How did you get there?','Has it changed much since you were young?'] },
    { name:'Brighton', region:'England', emoji:'🎡', hint:'The seaside town famous for its pier',
      prompts:['Have you ever been to Brighton?','Did you ever eat fish and chips by the sea?','What do you remember about the pier or the pebble beach?','Did you go on a day trip or stay over?','What did you think of the sea air?'] },
    { name:'Scotland', region:'UK', emoji:'🏴󠁧󠁢󠁳󠁣󠁴󠁿', hint:'The land of mountains, lochs and castles',
      prompts:['Have you ever been to Scotland?','What did you think of the scenery?','Did you ever try haggis or a Scottish breakfast?','Do you remember how cold it was?','What word would you use to describe Scotland?'] },
    { name:'Cornwall', region:'England', emoji:'⛵', hint:'The rugged coast at the very tip of England',
      prompts:['Have you ever visited Cornwall?','Did you ever have a Cornish pasty by the sea?','What beaches do you remember?','Did you take the long drive down or go by train?','What\'s your favourite thing about that part of England?'] },
    { name:'The Lake District', region:'England', emoji:'🏔️', hint:'Beautiful lakes and fells in Cumbria',
      prompts:['Have you ever been to the Lake District?','Did you ever go walking in the hills?','What lakes do you remember — Windermere? Grasmere?','Was it a holiday or a special trip?','Do you think it\'s the most beautiful part of England?'] },
    { name:'York', region:'England', emoji:'⛪', hint:'An ancient walled city with a famous Minster',
      prompts:['Have you visited York?','Did you walk along the old city walls?','What did you think of the Minster?','Did you visit the Shambles — the old medieval street?','What\'s your favourite thing about old English towns?'] },
    { name:'Wales', region:'UK', emoji:'🐉', hint:'Land of dragons, valleys and wonderful singing',
      prompts:['Have you ever been to Wales?','What did you think of the mountains or valleys?','Did you hear any Welsh spoken?','Do you have a favourite part of Wales?','What comes to mind when you think of Wales?'] },
    { name:'The Norfolk Broads', region:'England', emoji:'🚣', hint:'A beautiful network of rivers and waterways',
      prompts:['Have you ever been to the Norfolk Broads?','Did you ever go on a boat trip?','What do you remember about the flat landscape and big skies?','Do you like the idea of a slow boat holiday?','What wildlife do you remember — ducks, herons, swans?'] },
    { name:'Edinburgh', region:'Scotland', emoji:'🏰', hint:'Scotland\'s magnificent capital city',
      prompts:['Have you been to Edinburgh?','Did you see the castle on the rock?','What about the Royal Mile — did you walk it?','Did you visit at Festival time?','What word would describe Edinburgh for you?'] },
    { name:'Blackpool', region:'England', emoji:'🎢', hint:'The famous seaside resort with its tower and illuminations',
      prompts:['Have you ever been to Blackpool?','Did you go up Blackpool Tower?','What do you remember about the illuminations?','Did you ride the trams along the front?','Is Blackpool your idea of a perfect British holiday?'] },
  ],
  europe: [
    { name:'Paris', region:'France', emoji:'🗼', hint:'The city of light, love and the Eiffel Tower',
      prompts:['Have you ever been to Paris?','Did you see the Eiffel Tower?','What did you think of the food — the bread, the croissants?','Did you go to the Louvre or any museums?','What is one word you\'d use for Paris?'] },
    { name:'Rome', region:'Italy', emoji:'🏛️', hint:'The eternal city, full of ancient wonders',
      prompts:['Have you visited Rome?','Did you see the Colosseum or throw a coin in the Trevi Fountain?','What did you think of the heat?','Did you eat beautiful Italian food there?','What surprised you most about Rome?'] },
    { name:'Venice', region:'Italy', emoji:'🚣', hint:'The magical city built on water',
      prompts:['Have you been to Venice?','Did you take a gondola or a water bus?','What did you think of a city with no cars?','What did you notice about the smell of the canals?','If you could go back to Venice, would you?'] },
    { name:'Spain', region:'Europe', emoji:'☀️', hint:'Land of sun, flamenco and wonderful food',
      prompts:['Have you ever been to Spain?','Where did you go — Madrid, Barcelona, or the coast?','What do you remember about the weather?','Did you try paella or tapas?','What\'s your favourite thing about Spain?'] },
    { name:'Amsterdam', region:'Netherlands', emoji:'🚲', hint:'The city of canals, bicycles and tulips',
      prompts:['Have you visited Amsterdam?','What do you remember about the canals and bridges?','Did you notice how many bicycles there were?','Did you visit the Rijksmuseum or Anne Frank\'s house?','What surprised you about Amsterdam?'] },
    { name:'Switzerland', region:'Europe', emoji:'🏔️', hint:'The land of mountains, chocolate and cuckoo clocks',
      prompts:['Have you ever been to Switzerland?','Did you see the Alps?','What was it like being surrounded by such tall mountains?','Did you have Swiss chocolate while you were there?','Would you like to live somewhere with mountains?'] },
  ],
  nature: [
    { name:'The Seaside', region:'Nature', emoji:'🌊', hint:'The sound of waves, the smell of salt and seaweed',
      prompts:['What is your favourite seaside memory?','Did you paddle or swim in the sea as a child?','What do you remember about the smell of the sea air?','Did your family go to the seaside every year?','What would you buy at a seaside shop?'] },
    { name:'The Countryside', region:'Nature', emoji:'🌾', hint:'Rolling fields, hedgerows and birdsong',
      prompts:['Do you love the countryside?','What sounds do you remember — birds, church bells, a tractor?','Did you ever pick blackberries or go for long country walks?','What time of year is the countryside most beautiful to you?','What does the countryside smell like to you?'] },
    { name:'A British Garden', region:'Nature', emoji:'🌹', hint:'Roses, bees, the smell of cut grass',
      prompts:['Do you love gardens?','What flowers have you grown or been given?','What does a garden smell like on a summer afternoon?','Did you ever have a garden of your own?','What bird would you most like to see in a garden?'] },
    { name:'The Forest', region:'Nature', emoji:'🌲', hint:'Ancient trees, fallen leaves and quiet paths',
      prompts:['Do you like walking in a forest or wood?','What do you notice — the light through the trees, the sounds?','Did you ever collect conkers or acorns as a child?','What season is best in a forest — spring bluebells or autumn leaves?','Do forests feel magical to you?'] },
    { name:'The English Moors', region:'Nature', emoji:'🌫️', hint:'Wild, open and windswept — like something from a novel',
      prompts:['Have you ever walked on moorland?','Does it remind you of books like Wuthering Heights?','What do you imagine it sounds like up on the moors?','Would you find it peaceful or a bit lonely?','What wild things might you spot — a fox, a grouse, a wild pony?'] },
  ],
  nostalgic: [
    { name:'The Corner Shop', region:'Nostalgic Britain', emoji:'🏪', hint:'Where you went for a penn\'orth of sweets',
      prompts:['Do you remember your local corner shop?','What sweets did you buy as a child?','Do you remember what a penny would buy?','Was the shopkeeper someone you knew well?','What do you miss most about old corner shops?'] },
    { name:'The Village Fête', region:'Nostalgic Britain', emoji:'🎪', hint:'Bunting, tombola and a Victoria sponge competition',

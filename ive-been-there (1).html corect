    { name:'The Old Cinema', region:'Nostalgic Britain', emoji:'🎬', hint:'The picture house — a night at the pictures',
      prompts:['Do you remember going to the cinema as a young woman?','What was the first film you remember seeing?','Was there a cinema near where you grew up?','Do you remember the usherette with the tray of ice creams?','What was your favourite film star in those days?'] },
    { name:'The Dance Hall', region:'Nostalgic Britain', emoji:'💃', hint:'Big bands, twirling skirts and a night to remember',
      prompts:['Did you ever go dancing?','What kind of dancing — ballroom, jive, something else?','What do you remember about the music?','Did you have a favourite dress you\'d wear?','Do you have a particular memory of a wonderful evening dancing?'] },
    { name:'The High Street', region:'Nostalgic Britain', emoji:'🛍️', hint:'Woolworths, the market stalls and the smell of bakeries',
      prompts:['What do you remember about the old high street?','Did you shop at Woolworths?','What shops do you miss that don\'t exist anymore?','Was Saturday shopping a big occasion?','What would you buy yourself as a treat?'] },
    { name:'The Train Journey', region:'Nostalgic Britain', emoji:'🚂', hint:'Steam engines, packed lunches and watching the world go by',
      prompts:['Do you love train travel?','What\'s the best train journey you ever took?','Do you remember steam trains?','What would you pack for a long journey?','Where would your dream train journey take you?'] },
  ]
};

let category = 'uk';
let queue = [];
let current = null;
let stats = { places: 0, great: 0, ok: 0 };
let history = [];

function setCat(c) {
  category = c;
  document.querySelectorAll('.cat-btn').forEach(b => b.classList.remove('active'));
  document.getElementById('cat-' + c).classList.add('active');
}

function shuffle(arr) {
  const a = [...arr];
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}

function showPhase(id) {
  document.querySelectorAll('.phase').forEach(p => p.classList.remove('active'));
  document.getElementById('phase-' + id).classList.add('active');
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

function updateStats() {
  document.getElementById('s-places').textContent = stats.places;
  document.getElementById('s-great').textContent = stats.great;
  document.getElementById('s-ok').textContent = stats.ok;
}

function startGame() {
  queue = shuffle(PLACES[category]);
  showNextPlace();
}

function showNextPlace() {
  if (queue.length === 0) queue = shuffle(PLACES[category]);
  current = queue.shift();

  document.getElementById('place-region').textContent = current.region.toUpperCase();
  document.getElementById('place-emoji').textContent = current.emoji;
  document.getElementById('place-name').textContent = current.name;
  document.getElementById('place-hint').textContent = current.hint;

  const list = document.getElementById('prompts-list');
  list.innerHTML = '';
  current.prompts.forEach(p => {
    const div = document.createElement('div');
    div.className = 'prompt-item';
    div.innerHTML = `<span class="prompt-dot">◆</span><span>${p}</span>`;
    div.onclick = () => div.classList.toggle('used');
    list.appendChild(div);
  });

  showPhase('play');
}

function recordScore(type) {
  stats.places++;
  if (type === 'great') stats.great++;
  if (type === 'ok') stats.ok++;
  updateStats();
  history.unshift({ name: current.name, type });

  const title = document.getElementById('result-title');
  const sub = document.getElementById('result-sub');

  if (type === 'great') {
    title.textContent = '🌟 Wonderful!';
    sub.textContent = `She had a lot to say about ${current.name}. Beautiful.`;
  } else if (type === 'ok') {
    title.textContent = '👍 Lovely!';
    sub.textContent = `Something came up about ${current.name} — that's what matters.`;
  } else {
    title.textContent = '→ No matter!';
    sub.textContent = `Not every place sparks a memory. On to the next one.`;
  }

  document.getElementById('result-memory-box').style.display = type !== 'skip' ? 'block' : 'none';
  document.getElementById('memory-note').value = '';
  showPhase('result');
}

function nextPlace() { showNextPlace(); }

function backToSetup() {
  showPhase('setup');
  if (history.length === 0) return;
  document.getElementById('history-panel').style.display = 'block';
  const list = document.getElementById('history-list');
  list.innerHTML = '';
  history.slice(0, 8).forEach(h => {
    const div = document.createElement('div');
    div.className = 'history-entry';
    const label = h.type === 'great' ? '🌟 Great' : h.type === 'ok' ? '👍 Good' : '→ Skipped';
    div.innerHTML = `<span class="history-place">${h.name}</span><span class="history-score ${h.type}">${label}</span>`;
    list.appendChild(div);
  });
}

updateStats();
</script>
